# =====================================================================
# At least one provider should be configured. The frontend dropdown shows
# unconfigured providers in disabled state. If nothing is set, the app
# falls back to the rule-based heuristic mode (no LLM).
# =====================================================================

# --- Anthropic (Claude) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Override the default model (default: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Override the default model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- Ollama (local) ---
# Install: https://ollama.com/download
# Run a model: `ollama pull llama3 && ollama serve`
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# --- Provider selection (optional) ---
# Default provider when the frontend doesn't specify one.
# Values: anthropic | openai | ollama | heuristic
# LLM_PROVIDER=anthropic

# --- Fallback chain (optional) ---
# Comma-separated provider names tried if the primary provider fails.
# Useful for local-first setups, e.g.: LLM_FALLBACK=openai
# LLM_FALLBACK=

# --- Upload limits ---
# MAX_UPLOAD_MB=15
